{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "I CONFESS design tokens. Single source of truth for mobile (Flutter), web and admin (Next.js). Generated code lives in design/generated/ and must never be hand-edited. Section 12 of the build directive.",
  "color": {
    "brand": {
      "50":  { "$value": "#EAF7F1", "$type": "color" },
      "100": { "$value": "#CFEDE0", "$type": "color" },
      "200": { "$value": "#A3DDC6", "$type": "color" },
      "300": { "$value": "#74C9AB", "$type": "color" },
      "400": { "$value": "#4BB590", "$type": "color" },
      "500": { "$value": "#2A9D76", "$type": "color", "$description": "Brand green. Section 12 mandates a green primary." },
      "600": { "$value": "#1F7E5E", "$type": "color", "$description": "Primary action on light surfaces." },
      "700": { "$value": "#186248", "$type": "color" },
      "800": { "$value": "#124A37", "$type": "color" },
      "900": { "$value": "#0C3325", "$type": "color" }
    },
    "accent": {
      "gold": { "$value": "#C9A227", "$type": "color", "$description": "Premium and liturgical accent only. Never a primary action." }
    },
    "neutral": {
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "50":  { "$value": "#F5F7F6", "$type": "color" },
      "100": { "$value": "#E9EDEC", "$type": "color" },
      "200": { "$value": "#D3DAD8", "$type": "color" },
      "300": { "$value": "#B0BAB7", "$type": "color" },
      "400": { "$value": "#8A9591", "$type": "color" },
      "500": { "$value": "#667270", "$type": "color" },
      "600": { "$value": "#4B5654", "$type": "color" },
      "700": { "$value": "#333C3A", "$type": "color" },
      "800": { "$value": "#212927", "$type": "color" },
      "900": { "$value": "#141918", "$type": "color" },
      "950": { "$value": "#0A0E0D", "$type": "color" }
    },
    "semantic": {
      "$description": "Each has a light and a dark variant. A single mid-tone cannot reach 4.5:1 on both near-black and white, and the alternative - one value per theme chosen by hand later - is how contrast regresses screen by screen.",
      "success": {
        "light": { "$value": "#1F7E5E", "$type": "color" },
        "dark":  { "$value": "#4BB590", "$type": "color" }
      },
      "warning": {
        "light": { "$value": "#8A6114", "$type": "color" },
        "dark":  { "$value": "#D9A441", "$type": "color" }
      },
      "danger": {
        "light": { "$value": "#C0453C", "$type": "color" },
        "dark":  { "$value": "#E8776E", "$type": "color" }
      },
      "info": {
        "light": { "$value": "#3A6EA5", "$type": "color" },
        "dark":  { "$value": "#7FAEDC", "$type": "color" }
      }
    }
  },

  "spacing": {
    "$description": "Section 12: spacing scale runs 4 to 64. No value outside this scale may be used.",
    "0":  { "$value": "0px",  "$type": "dimension" },
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "7":  { "$value": "32px", "$type": "dimension" },
    "8":  { "$value": "40px", "$type": "dimension" },
    "9":  { "$value": "48px", "$type": "dimension" },
    "10": { "$value": "64px", "$type": "dimension" }
  },

  "radius": {
    "$description": "Section 12: 8, 12, 16, 20 and full only.",
    "sm":   { "$value": "8px",   "$type": "dimension" },
    "md":   { "$value": "12px",  "$type": "dimension" },
    "lg":   { "$value": "16px",  "$type": "dimension" },
    "xl":   { "$value": "20px",  "$type": "dimension" },
    "full": { "$value": "999px", "$type": "dimension" }
  },

  "font": {
    "family": {
      "sans":  { "$value": "'Inter', 'SF Pro Text', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
      "serif": { "$value": "'Source Serif 4', 'Iowan Old Style', Georgia, serif", "$type": "fontFamily", "$description": "Scripture and confession body text. Set apart from the interface on purpose." }
    },
    "size": {
      "display":    { "$value": "34px", "$type": "dimension" },
      "heading":    { "$value": "24px", "$type": "dimension" },
      "subheading": { "$value": "18px", "$type": "dimension" },
      "body":       { "$value": "16px", "$type": "dimension" },
      "bodySm":     { "$value": "14px", "$type": "dimension" },
      "caption":    { "$value": "12px", "$type": "dimension" },
      "label":      { "$value": "11px", "$type": "dimension" },
      "metric":     { "$value": "28px", "$type": "dimension" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.2, "$type": "number" },
      "snug":    { "$value": 1.35, "$type": "number" },
      "normal":  { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.7, "$type": "number", "$description": "Long-form scripture. Readability is the point of the product." },
      "metric":  { "$value": 1.1, "$type": "number" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0em",     "$type": "dimension" },
      "wide":   { "$value": "0.08em",  "$type": "dimension" }
    }
  },

  "typography": {
    "$description": "Section 12 roles. These seven, and no others, are available to product surfaces.",
    "display":    { "fontFamily": "{font.family.sans}",  "fontSize": "{font.size.display}",    "fontWeight": "{font.weight.bold}",     "lineHeight": "{font.lineHeight.tight}",   "letterSpacing": "{font.letterSpacing.tight}" },
    "heading":    { "fontFamily": "{font.family.sans}",  "fontSize": "{font.size.heading}",    "fontWeight": "{font.weight.semibold}","lineHeight": "{font.lineHeight.snug}",    "letterSpacing": "{font.letterSpacing.normal}" },
    "subheading": { "fontFamily": "{font.family.sans}",  "fontSize": "{font.size.subheading}", "fontWeight": "{font.weight.semibold}","lineHeight": "{font.lineHeight.snug}",    "letterSpacing": "{font.letterSpacing.normal}" },
    "body":       { "fontFamily": "{font.family.serif}", "fontSize": "{font.size.body}",       "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.relaxed}", "letterSpacing": "{font.letterSpacing.normal}" },
    "bodySm":     { "fontFamily": "{font.family.sans}",  "fontSize": "{font.size.bodySm}",     "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}",  "letterSpacing": "{font.letterSpacing.normal}" },
    "caption":    { "fontFamily": "{font.family.sans}",  "fontSize": "{font.size.caption}",    "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}",  "letterSpacing": "{font.letterSpacing.normal}" },
    "label":      { "fontFamily": "{font.family.sans}",  "fontSize": "{font.size.label}",      "fontWeight": "{font.weight.medium}",  "lineHeight": "{font.lineHeight.normal}",  "letterSpacing": "{font.letterSpacing.wide}" },
    "metric":     { "fontFamily": "{font.family.sans}",  "fontSize": "{font.size.metric}",     "fontWeight": "{font.weight.bold}",     "lineHeight": "{font.lineHeight.metric}",  "letterSpacing": "{font.letterSpacing.tight}" }
  },

  "elevation": {
    "0": { "$value": "none", "$type": "shadow" },
    "1": { "$value": "0 1px 2px rgba(10, 14, 13, 0.16)", "$type": "shadow" },
    "2": { "$value": "0 2px 8px rgba(10, 14, 13, 0.18)", "$type": "shadow" },
    "3": { "$value": "0 8px 24px rgba(10, 14, 13, 0.24)", "$type": "shadow" },
    "4": { "$value": "0 16px 48px rgba(10, 14, 13, 0.32)", "$type": "shadow" }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "100ms", "$type": "duration" },
      "fast":    { "$value": "160ms", "$type": "duration" },
      "base":    { "$value": "240ms", "$type": "duration" },
      "slow":    { "$value": "400ms", "$type": "duration" },
      "deliberate": { "$value": "700ms", "$type": "duration", "$description": "Breathing and session transitions. Slower on purpose." }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
      "emphasized": { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$type": "cubicBezier" },
      "decelerate": { "$value": "cubic-bezier(0, 0, 0, 1)", "$type": "cubicBezier" }
    }
  },

  "navigation": {
    "bottom": {
      "$description": "Section 12: exactly five destinations, in this order. A sixth tab is a design failure, not a feature request - every additional destination divides attention that belongs to the session. This lives in tokens so the rule is testable rather than remembered.",
      "$type": "string",
      "$value": "home,explore,confess,activity,profile"
    }
  },

  "zIndex": {
    "base":     { "$value": 0,   "$type": "number" },
    "raised":   { "$value": 10,  "$type": "number" },
    "sticky":   { "$value": 100, "$type": "number" },
    "player":   { "$value": 200, "$type": "number", "$description": "The persistent player sits above content and below modals." },
    "overlay":  { "$value": 900, "$type": "number" },
    "modal":    { "$value": 1000,"$type": "number" },
    "toast":    { "$value": 1100,"$type": "number" }
  },

  "theme": {
    "dark": {
      "$description": "Default. A night-time prayer app is the primary use.",
      "background":      { "$value": "{color.neutral.950}", "$type": "color" },
      "surface":         { "$value": "{color.neutral.900}", "$type": "color" },
      "surfaceRaised":   { "$value": "{color.neutral.800}", "$type": "color" },
      "border":          { "$value": "{color.neutral.700}", "$type": "color" },
      "textPrimary":     { "$value": "{color.neutral.100}", "$type": "color" },
      "textSecondary":   { "$value": "{color.neutral.400}", "$type": "color" },
      "textDisabled":    { "$value": "{color.neutral.600}", "$type": "color" },
      "primary":         { "$value": "{color.brand.400}",   "$type": "color" },
      "primaryStrong":   { "$value": "{color.brand.500}",   "$type": "color" },
      "onPrimary":       { "$value": "{color.neutral.950}", "$type": "color" },
      "success":         { "$value": "{color.semantic.success.dark}",  "$type": "color" },
      "warning":         { "$value": "{color.semantic.warning.dark}",  "$type": "color" },
      "danger":          { "$value": "{color.semantic.danger.dark}",   "$type": "color" },
      "info":            { "$value": "{color.semantic.info.dark}",     "$type": "color" },
      "playerBackground":{ "$value": "{color.brand.900}",   "$type": "color" }
    },
    "light": {
      "background":      { "$value": "{color.neutral.0}",   "$type": "color" },
      "surface":         { "$value": "{color.neutral.50}",  "$type": "color" },
      "surfaceRaised":   { "$value": "{color.neutral.0}",   "$type": "color" },
      "border":          { "$value": "{color.neutral.200}", "$type": "color" },
      "textPrimary":     { "$value": "{color.neutral.900}", "$type": "color" },
      "textSecondary":   { "$value": "{color.neutral.600}", "$type": "color" },
      "textDisabled":    { "$value": "{color.neutral.400}", "$type": "color" },
      "primary":         { "$value": "{color.brand.600}",   "$type": "color" },
      "primaryStrong":   { "$value": "{color.brand.700}",   "$type": "color" },
      "onPrimary":       { "$value": "{color.neutral.0}",   "$type": "color" },
      "success":         { "$value": "{color.semantic.success.light}", "$type": "color" },
      "warning":         { "$value": "{color.semantic.warning.light}", "$type": "color" },
      "danger":          { "$value": "{color.semantic.danger.light}",  "$type": "color" },
      "info":            { "$value": "{color.semantic.info.light}",    "$type": "color" },
      "playerBackground":{ "$value": "{color.brand.50}",    "$type": "color" }
    }
  }
}
