{
  "name": "iconfess-web",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "dev:api": "node ../scripts/dev-api.mjs",
    "bible:corpus": "python3 ../scripts/dev-bible-corpus.py"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  },
  "description": "iCONFESS web \u2014 the public site, the authenticated app and the admin console in one Next.js application. Consumes the Go API through the same-origin /api proxy."
}
