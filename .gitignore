# Binaries
/bin/
*.exe

# Local database + generated media
/data/
*.db
*.db-wal
*.db-shm

# Go
/go/        # (only relevant if GOROOT is vendored in this workspace)
.ps1
# Compiled binaries must not be committed: they bloat every clone and go stale
# against the source they were built from.
/server/bin/
server/bin/

# Local editor history plugin output.
.history/

# Dart/Flutter build artefacts
.dart_tool/
.packages
build/
*.iml

# One-shot apply scripts contain embedded copies of the source tree; keeping
# them in the repo means every clone carries a stale duplicate.
APPLY_*.ps1
FIX_*.ps1

# Patch dumps and editor residue must never be committed. A 15,885-line
# patch file and a 0-byte `client/me` (residue of a mis-typed curl -o) both
# reached the repository root before this rule existed.
*.patch
*.orig
*.rej
.md

# Python bytecode — generated, never source
__pycache__/
*.pyc
